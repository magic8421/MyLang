class Logger {
    native void puts(string s);
    native void puti(i32 v);
}

i32 main() {
    Logger log = new Logger;

    StringBuilder sb = new StringBuilder;
    sb.append_string("hello ");
    sb.append_string("world");
    sb.append_char('\n');
    sb.append_string("answer = ");
    sb.append_i32(42);
    sb.append_char('\n');
    sb.append_string("neg = ");
    sb.append_i32(-123);
    sb.append_char('\n');
    sb.append_char('\n');

    string result = sb.toString();
    log.puts(result);

    return 0;
}
