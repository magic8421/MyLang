struct SdlEvent {
    u32 type;
    u32 code;
}

const u32 LTK_LBUTTON_DOWN = 1;
const u32 LTK_LBUTTON_UP = 2;
const u32 LTK_RBUTTON_DOWN = 3;
const u32 LTK_RBUTTON_UP = 4;
const u32 LTK_WHEEL_UP = 5;
const u32 LTK_WHEEL_DOWN = 6;

enum ltkMouseAction {
    LButtonUp, LButtonDown, RButtonUp, RButtonDown, WheelUp, WheelDown
}

struct ltkMouseEvent {
    u32 action;
    u32 button;
    i32 wheel_x;
    i32 wheel_y;
    f32 x;
    f32 y;
}

struct ltkKeyEvent {
    u32 scancode;    // SDL physical key code
    u32 key;         // SDL virtual key code
    u32 mod;         // current key modifiers
}

interface SdlEventListener {
    void onEvent(SdlEvent e);
    void onMouseEvent(ref ltkMouseEvent ev) {}
    void onKeyEvent(ref ltkKeyEvent ev) {}
}



class SdlWindow {
    private u64 handle;
    private u32 window_id;
    public unowned SdlApp app;

    u32 getId() {
        return this.window_id;
    }
    bool isValid() {
        return this.handle != 0;
    }
}

class SdlApp {
    private SdlWindow[] windows;

    SdlWindow windowFromId(u32 id) {
        for (u32 i = 0; i < this.windows.length(); i++) {
            if (this.windows[i].getId() == id) {
                return this.windows[i];
            }
        }
        return null;
    }

    void onMouseEvent(ref ltkMouseEvent e) {

    }
    void onKeyEvent(ref ltkKeyEvent ev) {

    }

    native i32 init();
    native SdlWindow createWindow(i32 w, i32 h);
    native void pump();
    native i32 shouldQuit();
    native void delay(i32 ms);
    native void destroyWindow(SdlWindow win);
    native void quit();
    native string eventTypeToString(u32 type);
}

class Logger {
    public unowned SdlApp app;
    void onEvent(SdlEvent e) {
        match(e.type) {
            1024 => { return; } // SDL_EVENT_MOUSE_MOTION
            516 => { return; } // SDL_EVENT_WINDOW_EXPOSED
            517 => { return; } // SDL_EVENT_WINDOW_MOVED
        }
        string type_str = this.app.eventTypeToString(e.type);
        print(f"SDL Event: [{e.type}]{type_str} {e.code}");
    }
    void onMouseEvent(ref ltkMouseEvent e) {
        print(f"SDL Event: ltkMouseEvent {e.button} {e.x} {e.y}");
    }
    void onKeyDown(ref ltkKeyEvent e) {
        print(f"SDL Event: ltkKeyEvent {e.key}");
    }
}

i32 main() {
    SdlApp app = new SdlApp;
    if (app.init() != 0) {
        return 1;
    }

    SdlWindow win = app.createWindow(640, 480);
    if (!win.isValid()) {
        app.quit();
        return 2;
    }

    while (app.shouldQuit() == 0) {
        app.pump();
        app.delay(16);
    }

    app.destroyWindow(win);
    app.quit();
    return 0;
}
