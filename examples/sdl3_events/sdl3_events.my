namespace ltk {

struct Event {
    u32 type;
    u32 code;
}

enum MouseAction {
    LButtonUp, LButtonDown, RButtonUp, RButtonDown, WheelUp, WheelDown
}

struct MouseEvent {
    u32 window_id;
    u32 action;
    u32 button;
    i32 wheel_x;
    i32 wheel_y;
    f32 x;
    f32 y;
}

struct KeyEvent {
    u32 window_id;
    u32 scancode;    // SDL physical key code
    u32 key;         // SDL virtual key code
    u32 mod;         // current key modifiers
}

struct TextInputEvent {
    u32 window_id;
    string text;
}

interface EventListener {
    void onEvent(Event e);
    void onMouseEvent(ref MouseEvent ev) {}
    void onKeyEvent(ref KeyEvent ev) {}
}

class Window {
    private u64 handle;
    private u64 renderer;
    private u32 window_id;
    private unowned Application app;

    u32 getId() {
        return this.window_id;
    }
    bool isValid() {
        return this.handle != 0;
    }
    native SdlTexture createTextureFromFile(string path);
    void onMouseEvent(ref MouseEvent e) {
        print(f"Window {this.window_id}: MouseEvent {e.button} {e.x} {e.y}");
    }
    void onKeyEvent(ref KeyEvent e) {
        print(f"Window: KeyEvent {e.key}");
    }
    void onTextInput(ref TextInputEvent e) {
        print(f"Window: TextInputEvent {e.text}");
    }
}

class SdlTexture {
    private u64 handle;

    bool isValid() {
        return this.handle != 0;
    }
}

class Application {
    private Window[] windows;

    Window windowFromId(u32 id) {
        //print(f"windowFromId {this.windows.length()} >>>");
        foreach (Window win in this.windows) {
            //print(f"windowFromId: {win.getId()} == {id}");
            if (win.getId() == id) {
                return win;
            }
        }
         //print("windowFromId <<<");
        return null;
    }

    void example() {
        this.windows.push(new Window);
        string s = "Hello";
    }

    void onMouseEvent(ref MouseEvent e) {
        Window wnd = this.windowFromId(e.window_id);
        if (wnd) {
            wnd.onMouseEvent(ref e);
        } else {
            print(f"Cannot find window_id:{e.window_id}");
        }
    }
    void onKeyEvent(ref KeyEvent e) {
        Window wnd = this.windowFromId(e.window_id);
        if (wnd) {
            wnd.onKeyEvent(ref e);
        } else {
            print(f"Cannot find window_id:{e.window_id}");
        }
    }
    void onTextInput(ref TextInputEvent e) {
        Window wnd = this.windowFromId(e.window_id);
        if (wnd) {
            wnd.onTextInput(ref e);
        } else {
            print(f"Cannot find window_id:{e.window_id}");
        }
    }

    native i32 init();
    native Window createWindow(i32 w, i32 h);
    native void pump();
    native i32 shouldQuit();
    native void delay(i32 ms);
    native void destroyWindow(Window win);
    native void quit();
    native string eventTypeToString(u32 type);
}

class Logger {
    public unowned Application app;
    void onEvent(Event e) {
        match(e.type) {
            1024 => { return; } // SDL_EVENT_MOUSE_MOTION
            516 => { return; } // SDL_EVENT_WINDOW_EXPOSED
            517 => { return; } // SDL_EVENT_WINDOW_MOVED
        }
        string type_str = this.app.eventTypeToString(e.type);
        print(f"SDL Event: [{e.type}]{type_str} {e.code}");
    }
    void onMouseEvent(ref MouseEvent e) {
        print(f"SDL Event: MouseEvent {e.button} {e.x} {e.y}");
    }
    void onKeyDown(ref KeyEvent e) {
        print(f"SDL Event: KeyEvent {e.key}");
    }
}

} // namespace ltk

i32 main() {
    ltk.Application app = new ltk.Application;
    if (app.init() != 0) {
        return 1;
    }

    ltk.Window win = app.createWindow(640, 480);
    if (!win.isValid()) {
        app.quit();
        return 2;
    }

    while (app.shouldQuit() == 0) {
        app.pump();
        app.delay(16);
    }

    app.destroyWindow(win);
    app.quit();
    return 0;
}
