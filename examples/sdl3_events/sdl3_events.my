struct SdlEvent {
    u32 type;
    u32 code;
}

struct SdlMouseButtonEvent {
    u8 button;
    f32 x;
    f32 y;
}

interface SdlEventListener {
    void onEvent(SdlEvent e);
    void onMouseButtonDown(ref SdlMouseButtonEvent ev) {}
}



class SdlWindow {
    private u64 handle;
    public unowned SdlApp app;
    bool isValid() {
        return this.handle != 0;
    }
}

class SdlApp {
    native i32 init();
    native SdlWindow createWindow(i32 w, i32 h);
    native void addListener(SdlEventListener l);
    native void removeListener(SdlEventListener l);
    native void pump();
    native i32 shouldQuit();
    native void delay(i32 ms);
    native void destroyWindow(SdlWindow win);
    native void quit();
    native string eventTypeToString(u32 type);
}

class Logger : SdlEventListener {
    public unowned SdlApp app;
    override void onEvent(SdlEvent e) {
        match(e.type) {
            1024 => { return; } // SDL_EVENT_MOUSE_MOTION
            516 => { return; } // SDL_EVENT_WINDOW_EXPOSED
            517 => { return; } // SDL_EVENT_WINDOW_MOVED
        }
        string type_str = this.app.eventTypeToString(e.type);
        print(f"SDL Event: [{e.type}]{type_str} {e.code}");
    }
    override void onMouseButtonDown(ref SdlMouseButtonEvent e) {
        print(f"SDL Event: SdlMouseButtonEvent {e.button} {e.x} {e.y}");
    }
}

i32 main() {
    SdlApp app = new SdlApp;
    if (app.init() != 0) {
        return 1;
    }

    SdlWindow win = app.createWindow(640, 480);
    if (!win.isValid()) {
        app.quit();
        return 2;
    }

    Logger logger = new Logger;
    logger.app = app;
    app.addListener(logger);

    while (app.shouldQuit() == 0) {
        app.pump();
        app.delay(16);
    }

    app.removeListener(logger);
    app.destroyWindow(win);
    app.quit();
    return 0;
}
